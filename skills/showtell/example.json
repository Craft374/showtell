        "notes": [{ "bin": "4GB", "text": "적중률이 처음 75%에 닿는 크기" }],
        "scrub": true,
        "states": [{}, { "focus": ["4GB"] }]
      }
    },
    {
      "id": "envs",
      "title": "환경별 설정 바꿔 보기",
