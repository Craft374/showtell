          { "id": "a", "label": "정상 요청", "text": "결제 · 800ms — 사용자 불만 없음", "at": { "limit": "3초", "ms": 800 } }
        ],
        "states": [
          { "say": "오늘은 타임아웃과 응답 시간이 서비스마다 달랐다", "show": ["x"] },
          { "say": "불만이 없던 요청은 800ms", "show": ["x", "a"], "focus": ["a"] },
          { "say": "다음 배포에서는 타임아웃 하나만 고정한다", "set": { "x": { "label": "다음 배포", "at": { "limit": "3초", "ms": [null, null] }, "labels": { "limit": "**3초 고정**", "ms": "측정만" } } }, "show": ["x"] }
        ]
      }
    },
    {
      "id": "cache",
      "title": "캐시 크기와 적중률",
      "message": "캐시를 늘릴수록 적중률은 오르지만 4GB 이후로는 조금씩만 오른다.",
      "stage": {
