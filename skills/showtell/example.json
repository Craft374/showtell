      "stage": {
        "type": "lookup", "id": "env", "control": "tabs", "base": "prod",
        "fields": ["타임아웃 · 재시도", "로그 수준", "캐시"],
        "records": [
          { "id": "prod", "label": "운영", "badge": "기본", "values": ["**3초** · 2회", "warn", "4GB"] },
          { "id": "stage", "label": "스테이징", "values": ["**3초** · 2회", "info", "1GB"], "notes": ["", "배포 전 확인용", ""] },
          { "id": "dev", "label": "개발", "values": ["**3초** · 0회", "debug", "없음"] }
        ],
        "states": [{ "label": "운영", "record": "prod" }, { "label": "스테이징", "record": "stage" }, { "label": "개발", "record": "dev" }]
      }
    },
    {
      "id": "dashboard",
      "title": "대시보드에서 먼저 볼 자리",
      "message": "장애가 나면 위쪽 그래프부터 보고, 오른쪽 알림으로 원인을 좁힌다.",
      "stage": {
        "type": "photos", "id": "board",
        "items": [{ "id": "d", "name": "대시보드 (도식)", "frame": "16:9", "zones": [
          { "id": "t", "area": "top", "text": "위쪽: 오류율·응답 시간 그래프" },
          { "id": "r", "area": "right", "text": "오른쪽: 최근 알림 목록" }
        ] }],
        "states": [{ "zones": ["d.t"] }, { "zones": ["d.r"], "uncertain": "알림 위치는 팀 설정마다 다름" }]
      }
    },
    {
      "id": "check",
      "title": "배포 전 체크",
      "message": "배포 당일에 설정을 고치지 않게 전날 맞춰 둔다.",
      "blocks": [
        { "type": "checklist", "items": [
          { "text": "모든 환경 타임아웃 3초", "to": "timeout" },
