        "notes": [{ "bin": "f/5.6", "text": "f/2.8보다 2단 어두움" }],
        "scrub": true,
        "states": [{}, { "focus": ["f/5.6"] }]
      }
    },
    {
      "id": "presets",
      "title": "상황별 세팅 바꿔 보기",
      "message": "측광과 셔터만 바꾸면 되고 나머지는 같다.",
      "stage": {
        "type": "lookup", "id": "sit", "control": "tabs", "base": "people",
        "fields": ["모드 · 셔터", "ISO", "측광"],
        "records": [
          { "id": "people", "label": "인물", "badge": "기본", "values": ["M · **1/250**", "오토", "멀티"] },
          { "id": "stage", "label": "무대", "values": ["M · **1/250**", "오토", "하이라이트"], "notes": ["", "", "밝은 화면이 날아가지 않게"] },
          { "id": "group", "label": "단체", "values": ["M · 1/125", "오토", "멀티"] }
        ],
        "states": [{ "label": "인물", "record": "people" }, { "label": "무대", "record": "stage" }, { "label": "단체", "record": "group" }]
      }
    },
    {
      "id": "framing",
      "title": "28mm에서 사람은 가운데로",
      "message": "가장자리 얼굴은 왜곡 보정으로 늘어나 보인다.",
      "stage": {
        "type": "photos", "id": "frame",
        "items": [{ "id": "f", "name": "화면 (도식)", "frame": "3:2", "zones": [
          { "id": "c", "area": "center", "text": "얼굴은 화면 중앙 쪽에" },
          { "id": "e", "area": "edges", "text": "가장자리는 늘어나 보일 수 있음" }
        ] }],
        "states": [{ "zones": ["f.c"] }, { "zones": ["f.e"], "uncertain": "렌즈마다 정도가 다름" }]
      }
    },
    {
      "id": "check",
      "title": "출발 전 체크",
      "message": "현장에서 메뉴를 뒤지지 않게 전날 세팅해 둔다.",
      "blocks": [
        { "type": "checklist", "items": [
          { "text": "셔터 1/250초 고정", "to": "exposure" },
          "ISO 오토 확인",
          { "text": "무대에서는 하이라이트 측광", "note": "인물로 돌아오면 멀티", "to": "presets" }
        ] },
        { "type": "note", "tone": "uncertain", "text": "예시 값입니다. 현장 조명에 맞춰 조정하세요." }
