          { "id": "api", "label": "API 서버", "text": "주문·결제 처리", "col": 1, "row": 0, "key": "api" },
          { "id": "cache", "label": "캐시", "text": "최근 주문 정보", "col": 2, "row": 0 },
          { "id": "db", "label": "DB", "text": "모든 주문 기록", "col": 1, "row": 1, "uncertain": "읽기 전용 복제본 사용 여부는 확인 필요" }
