        "edges": [
          { "id": "app-api", "from": "app", "to": "api", "label": "요청" },
          { "id": "api-cache", "from": "api", "to": "cache", "label": "먼저 조회" },
          { "id": "api-db", "from": "api", "to": "db", "label": "캐시에 없을 때" }
        ],
        "states": [
          { "say": "요청은 앱에서 시작한다", "signal": "app" },
          { "say": "API 서버가 받는다", "signal": "api" },
          { "say": "먼저 캐시를 본다", "signal": "api", "flow": ["api-cache"], "focus": ["cache"] },
          { "say": "캐시에 없으면 DB까지 간다", "signal": "db", "set": { "api": { "text": "DB 응답을 기다림" } } }
        ]
      }
    },
    {
      "id": "slow",
      "title": "느린 요청은 어디서 나왔나",
      "message": "1초 넘는 요청 25건은 전부 결제 API였다.",
      "stage": {
        "type": "units", "id": "reqs", "total": 120, "unit": "건",
        "states": [
          { "say": "오늘 기록한 요청 전체", "groups": [{ "label": "전체", "n": 120 }] },
